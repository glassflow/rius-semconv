# Pinned tool and upstream versions. One file, so a bump is one reviewable
# line and Renovate (renovate.json) can open it as a pull request.
# tools/install_weaver.sh reads it, and tools/check_weaver_pins.py checks that
# model/manifest.yaml pins the same upstream registries.

# OTel Weaver, the registry checker and generator. A bump also needs the
# release's checksums below: `tools/install_weaver.sh --print-checksums`.
# renovate: datasource=github-releases depName=open-telemetry/weaver
WEAVER_VERSION=v0.28.0
WEAVER_SHA256_X86_64_UNKNOWN_LINUX_GNU=9878e2d56ad82ae441b0b527377a4f6001ae19f4af362fb0a4d951884f59ab61
WEAVER_SHA256_AARCH64_UNKNOWN_LINUX_GNU=dab3251667c64e7bf5e20f294667a5ac9c041ee21212f8390e6affe70c487ddc
WEAVER_SHA256_X86_64_APPLE_DARWIN=40dd65d72b43bc97041b849203e450b322cd786629af8f926cfd2d05798d9ca4
WEAVER_SHA256_AARCH64_APPLE_DARWIN=b334b37372325f77374b461fd6a11d38bc050122832eb83a9732fcd6831a5ab1

# OpenTelemetry semantic conventions (core).
# renovate: datasource=github-tags depName=open-telemetry/semantic-conventions
SEMCONV_VERSION=v1.44.0

# OpenTelemetry GenAI semantic conventions. The repository cuts no releases or
# tags, so it is pinned to a full commit on main.
# renovate: datasource=git-refs depName=https://github.com/open-telemetry/semantic-conventions-genai currentValue=main
SEMCONV_GENAI_REF=07794021bfe46e1c241408b6f55cb4354bd28318

# The shared OTel policy packs tools/weaver_check.py runs (stability and
# backwards-compatibility). The repository cuts no releases or tags, so it is
# pinned to a full commit on main.
# renovate: datasource=git-refs depName=https://github.com/open-telemetry/opentelemetry-weaver-packages currentValue=main
WEAVER_PACKAGES_REF=b524723bedec1cc8d9ef83c924a231348a669ebe
