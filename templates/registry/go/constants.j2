{#- The Go constants file: the CANONICAL half of the Rius backend's semconv
    package (every row generated for Go, the span-kind values, the
    allowlists and the tables). The normalizer's input spellings stay in the
    backend's hand-written semconv.go. Go names come from the shared context
    (the row's `go`, else PascalCase with a small initialism table). gofmt
    owns alignment and runs on the output afterwards (generators/weaver.py).
    The context is built in ../weaver.yaml. -#}
{% set lang = params.lang %}
{% set pre = params.preamble %}
{% set al = params.allowlists %}
{% set mp = params.model_parameters %}
{% set sk = params.taxonomy.span_kind %}
{% set initialisms = {"ID": "ID", "GEN": "Gen", "AI": "AI", "MCP": "MCP", "LLM": "LLM", "URL": "URL", "SDK": "SDK", "TTL": "TTL"} %}
{{- template.set_file_name(pre[lang].filename) -}}
{% macro comment(text, marker, indent) %}
{% if text %}
{% for line in text.rstrip("\n").split("\n") %}
{{ (indent ~ marker ~ " " ~ line).rstrip() }}
{% endfor %}
{% endif %}
{% endmacro %}
{#- A deprecated constant's rationale with its opening `Deprecated: ...` line
    moved to a paragraph of its own at the end, as godoc expects, so editors
    and linters mark the constant. -#}
{% macro deprecated_comment(text, indent) %}
{% set ns = namespace(lines=(text.rstrip("\n").split("\n") if text else []), tag=none) %}
{% if ns.lines and ns.lines[0].startswith("Deprecated: ") %}
{% set ns.tag = ns.lines[0] %}
{% set ns.lines = ns.lines[1:] %}
{% endif %}
{% for line in ns.lines %}
{{ (indent ~ "// " ~ line).rstrip() }}
{% endfor %}
{% if ns.tag %}
{% if ns.lines %}
{{ indent }}//
{% endif %}
{{ indent }}// {{ ns.tag }}
{% endif %}
{% endmacro %}
{% macro lit(value) %}"{{ value | replace("\\", "\\\\") | replace('"', '\\"') }}"{% endmacro %}
{% macro name_of(const) %}{{ ctx.go_names[const] }}{% endmacro %}
{% macro kind_const(kind) %}{{ sk.names[lang] }}{% if kind in initialisms %}{{ initialisms[kind] }}{% else %}{{ kind | capitalize }}{% endif %}{% endmacro %}
{% macro ref_or_literal(key) %}{% if key in ctx.const_for_key %}{{ name_of(ctx.const_for_key[key]) }}{% else %}{{ lit(key) }}{% endif %}{% endmacro %}
{% macro member(mem) %}{% if mem.ref %}{{ name_of(mem.ref) }}{% else %}{{ lit(mem.key) }}{% endif %}{% endmacro %}
{% macro member_set(section, extra="") %}

{{ comment(al[section].doc, "//", "") }}var {{ al[section].go }} = map[string]struct{}{
{% for mem in ctx.members[section] %}
{{ comment(mem.note, "//", "\t") }}	{{ member(mem) }}: {},
{% endfor %}
{{ extra }}}
{% endmacro %}
{% macro string_slice(section) %}

{{ comment(al[section].doc, "//", "") }}var {{ al[section].go }} = []string{
{% for v in al[section]["values"] %}
	{{ lit(v) }},
{% endfor %}
}
{% endmacro %}
// Code generated by rius-semconv. DO NOT EDIT.
//
{{ comment(pre.header, "//", "") }}
package {{ pre.go.package }}

const (
{% for row in ctx.rows %}
{% if not loop.first and (row.section or row.rationale) %}

{% endif %}
{{ comment(row.section, "//", "\t") }}{% if row.deprecated %}{{ deprecated_comment(row.rationale, "\t") }}{% else %}{{ comment(row.rationale, "//", "\t") }}{% endif %}	{{ name_of(row.const) }} = {{ lit(row.key) }}
{% endfor %}

	// Span kind values (openinference.span.kind).
{% for k in sk["values"] %}
	{{ kind_const(k.name) }} = {{ lit(k.name) }} // {{ k.doc }}
{% endfor %}
)

{{ comment(mp.doc, "//", "") }}var {{ mp.go }} = map[string]string{
{% for group in mp.groups %}
{% for spelling in group.spellings %}
{% if loop.first %}{{ comment(group.note, "//", "\t") }}{% endif %}
	{{ lit(spelling) }}: {{ ref_or_literal(group.target) }},
{% endfor %}
{% endfor %}
}
{{ member_set("pending_identity") -}}
{% set prefixes = al.pending_identity_prefixes %}
{% set ipc = al.invocation_parameters_content_members %}
{{ "\n" }}{{ comment(prefixes.doc, "//", "") }}var {{ prefixes.go }} = []string{ {%- for r in prefixes.refs %}{{ name_of(r) }}{% if not loop.last %}, {% endif %}{% endfor %}}

{{ comment(ipc.doc, "//", "") }}var {{ ipc.go }} = []string{ {%- for v in ipc["values"] %}{{ lit(v) }}{% if not loop.last %}, {% endif %}{% endfor %}}
{% set rpc = al.request_parameters_content_members %}

{{ comment(rpc.doc, "//", "") }}var {{ rpc.go }} = []string{ {%- for v in rpc["values"] %}{{ lit(v) }}{% if not loop.last %}, {% endif %}{% endfor %}}
{#- Go has no package-level comprehension, so the derived content keys are
    expanded here, and a map literal cannot fold another map in, so each
    included allowlist is emitted on its own and its members expanded into the
    content map too. -#}
{% set derived = al.content.derived %}
{% set extra %}
{% if derived %}
{{ comment(derived.note, "//", "\t") }}{% for prefix in derived.prefixes %}{% for m in rpc["values"] %}
	{{ name_of(prefix) }} + {{ lit(m) }}: {},
{% endfor %}{% endfor %}
{% endif %}
{% for section in ctx.included %}
	// Every member of {{ al[section].go }}.
{% for mem in ctx.members[section] %}
	{{ member(mem) }}: {},
{% endfor %}
{% endfor %}
{% endset %}
{% for section in ctx.included %}
{{ member_set(section) -}}
{% endfor %}
{{ member_set("content", extra) -}}
{{ string_slice("content_prefixes") -}}
{{ member_set("content_prefix_identity") -}}
{{ string_slice("content_suffixes") -}}
{% set block = al.content_prefixed_suffixes %}
{{ "\n" }}{{ comment(block.doc, "//", "") }}var {{ block.go }} = []struct {
	Prefix   string
	Suffixes []string
}{
{% for entry in block["values"] %}
	{{ "{" }}{{ lit(entry.prefix) }}, []string{ {%- for s in entry.suffixes %}{{ lit(s) }}{% if not loop.last %}, {% endif %}{% endfor %}}},
{% endfor %}
}
{{ string_slice("credential_headers") -}}
{{ string_slice("credential_header_suffixes") -}}
{{ string_slice("header_attribute_segments") -}}
{% for t in [
    ["operation_by_kind", "kind", "literal"],
    ["kind_by_operation", "literal", "kind"],
    ["name_target_by_kind", "kind", "ref"],
] if t[0] in ctx.tables %}
{% set table = ctx.tables[t[0]] %}

{{ comment(table.doc, "//", "") }}var {{ table.names[lang] }} = map[string]string{
{% for pair in table.map %}
	{% if t[1] == "kind" %}{{ kind_const(pair[0]) }}{% else %}{{ lit(pair[0]) }}{% endif %}: {% if t[2] == "kind" %}{{ kind_const(pair[1]) }}{% elif t[2] == "ref" %}{{ name_of(pair[1]) }}{% else %}{{ lit(pair[1]) }}{% endif %},
{% endfor %}
}
{% endfor %}
