{#- The TypeScript constants module: constants and tables only. The SDK's
    hand-written semconv.ts re-exports it and keeps the helper functions,
    because logic is not registry data. Shaped to pass `biome check` under the
    TypeScript SDK's configuration (100 columns, double quotes, trailing
    commas): an array that fits on one line is printed on one line, the way
    biome's formatter prints it. The context is built in ../weaver.yaml. -#}
{% set lang = params.lang %}
{% set width = 100 %}
{% set pre = params.preamble %}
{% set al = params.allowlists %}
{% set mp = params.model_parameters %}
{% set sk = params.taxonomy.span_kind %}
{% set kind_type = sk.names[lang] %}
{{- template.set_file_name(pre[lang].filename) -}}
{% macro comment(text, marker, indent) %}
{% if text %}
{% for line in text.rstrip("\n").split("\n") %}
{{ (indent ~ marker ~ " " ~ line).rstrip() }}
{% endfor %}
{% endif %}
{% endmacro %}
{% macro lit(value) %}"{{ value | replace("\\", "\\\\") | replace('"', '\\"') }}"{% endmacro %}
{% macro prop(key) %}{% if key | regex_replace("^[A-Za-z_$][A-Za-z0-9_$]*$", "") == "" %}{{ key }}{% else %}{{ lit(key) }}{% endif %}{% endmacro %}
{% macro ref_or_literal(key) %}{% if key in ctx.const_for_key %}{{ ctx.const_for_key[key] }}{% else %}{{ lit(key) }}{% endif %}{% endmacro %}
{#- `head[items]tail` on one line when it fits, else one item per line. -#}
{% macro array(head, items, tail=";") %}
{% set flat = head ~ "[" ~ items | join(", ") ~ "]" ~ tail %}
{% if flat | length <= width %}
{{ flat }}
{% else %}
{{ head }}[
{% for item in items %}
  {{ item }},
{% endfor %}
]{{ tail }}
{% endif %}
{% endmacro %}
{% macro set_of(head, section, extra="") %}
{{ head }}new Set([
{% for mem in ctx.members[section] %}
{{ comment(mem.note, "//", "  ") }}  {% if mem.ref %}{{ mem.ref }}{% else %}{{ lit(mem.key) }}{% endif %},
{% endfor %}
{{ extra }}]);
{% endmacro %}
{% macro member_set(section) %}

{{ comment(al[section].doc, "//", "") }}{{ set_of("export const " ~ al[section].const ~ ": ReadonlySet<string> = ", section) }}
{%- endmacro %}
{% macro literals(values) %}{% set ns = namespace(out=[]) %}{% for v in values %}{% set ns.out = ns.out + [lit(v)] %}{% endfor %}{{ ns.out | join("\x1f") }}{% endmacro %}
{% macro string_array(section) %}

{{ comment(al[section].doc, "//", "") }}{{ array("export const " ~ al[section].const ~ ": readonly string[] = ", literals(al[section]["values"]).split("\x1f")) }}
{%- endmacro %}
{% macro fmt(value, how) %}{% if how == "kind" %}{{ kind_type }}.{{ value }}{% elif how == "otel" %}OtelSpanKind.{{ value }}{% elif how == "ref" %}{{ value }}{% else %}{{ lit(value) }}{% endif %}{% endmacro %}
{{ comment(pre.notice, "//", "") }}{{ comment(pre.header, "//", "") }}
{% if "otel_kind_by_kind" in ctx.tables %}
import { SpanKind as OtelSpanKind } from "@opentelemetry/api";
{% endif %}
{% for imp in ctx.ts_imports %}
import { {{ imp.names | join(", ") }} } from {{ lit(imp.from) }};
{% endfor %}
{% for row in ctx.rows %}
{% if row.section or row.rationale %}

{% endif %}
{{ comment(row.section, "//", "") }}{{ comment(row.rationale, "//", "") }}export const {{ row.const }} = {% if row.ts_alias %}{{ row.ts_alias.name }}{% else %}{{ lit(row.key) }}{% endif %};
{% endfor %}

{{ comment(mp.doc, "//", "") }}export const {{ mp.const }}: Readonly<Record<string, string>> = {
{% for group in mp.groups %}
{% for spelling in group.spellings %}
{% if loop.first %}{{ comment(group.note, "//", "  ") }}{% endif %}
  {{ prop(spelling) }}: {{ ref_or_literal(group.target) }},
{% endfor %}
{% endfor %}
};

{{ comment(al.pending_identity.doc, "//", "") }}{{ set_of("export const " ~ al.pending_identity.const ~ ": ReadonlySet<string> = ", "pending_identity") -}}
{% set prefixes = al.pending_identity_prefixes %}

{{ comment(prefixes.doc, "//", "") }}{{ array("export const " ~ prefixes.const ~ ": readonly string[] = ", prefixes.refs) }}
{%- set ipc = al.invocation_parameters_content_members %}

{{ comment(ipc.doc, "//", "") }}{{ array("export const " ~ ipc.const ~ ": readonly string[] = ", literals(ipc["values"]).split("\x1f")) }}
{%- for section in ctx.included %}
{{ member_set(section) }}
{%- endfor %}
{% set content = al.content %}
{% set derived = content.derived %}
{% set extra %}
{% if derived %}
{{ comment(derived.note, "//", "  ") }}  ...[{{ derived.prefixes | join(", ") }}].flatMap((prefix) =>
    {{ derived.members }}.map((member) => `${prefix}${member}`),
  ),
{% endif %}
{% for section in ctx.included %}
  ...{{ al[section].const }},
{% endfor %}
{% endset %}

{{ comment(content.doc, "//", "") }}{{ set_of("export const " ~ content.const ~ ": ReadonlySet<string> = ", "content", extra) }}
{{- string_array("content_prefixes") -}}
{{ member_set("content_prefix_identity") -}}
{{ string_array("content_suffixes") -}}
{% set block = al.content_prefixed_suffixes %}
{% set ns = namespace(entries=[]) %}
{% for e in block["values"] %}
{% set ns.entries = ns.entries + ["[" ~ lit(e.prefix) ~ ", [" ~ literals(e.suffixes).split("\x1f") | join(", ") ~ "]]"] %}
{% endfor %}

{{ comment(block.doc, "//", "") }}export const {{ block.const }}: readonly (readonly [
  string,
  readonly string[],
{{ array("])[] = ", ns.entries) -}}
{{ "\n" }}{{ comment(sk.doc.replace("``", "`"), "//", "") }}export enum {{ kind_type }} {
{% for k in sk["values"] %}
  {{ k.name }} = {{ lit(k.name) }}, // {{ k.doc }}
{% endfor %}
}
{% for t in [
    ["operation_by_kind", "kind", "literal", "Partial<Record<" ~ kind_type ~ ", string>>"],
    ["kind_by_operation", "literal", "kind", "Record<string, " ~ kind_type ~ ">"],
    ["otel_kind_by_kind", "kind", "otel", "Record<" ~ kind_type ~ ", OtelSpanKind>"],
    ["name_target_by_kind", "kind", "ref", "Partial<Record<" ~ kind_type ~ ", string>>"],
] if t[0] in ctx.tables %}
{% set table = ctx.tables[t[0]] %}

{{ comment(table.doc, "//", "") }}export const {{ table.names[lang] }}: {{ t[3] }} = {
{% for pair in table.map %}
{{ "  " }}{% if t[1] == "kind" %}[{{ kind_type }}.{{ pair[0] }}]{% else %}{{ prop(pair[0]) }}{% endif %}: {{ fmt(pair[1], t[2]) }},
{% endfor %}
};
{% endfor %}
